        { "type": "TRANSFORM_TWO_CARDS", "label": [{ "t": 15 }], "refs": [], "excludedDrawbacks": [] },
        { "type": "TWENTY_PERCENT_HP_BONUS", "label": [{ "t": 16 }, { "v": { "of": "maxHp", "pct": 20 } }, { "s": " ]" }], "refs": [], "excludedDrawbacks": ["TEN_PERCENT_HP_LOSS"], "note": "Value is twice the floored 10% bonus." }
