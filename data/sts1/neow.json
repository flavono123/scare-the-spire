    {
      "index": 3,
      "name": "boss relic swap",
      "rewards": [
        { "type": "BOSS_RELIC", "label": [{ "u": 0 }], "refs": [{ "type": "relic", "tier": "starter", "note": "lost (the first relic in the relic bar)" }, { "type": "relic", "tier": "boss" }] }
      ]
