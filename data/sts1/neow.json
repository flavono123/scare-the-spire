      { "type": "THREE_ENEMY_KILL", "label": [{ "t": 28 }], "refs": [{ "type": "relic", "id": "NeowsBlessing" }] },
      { "type": "TEN_PERCENT_HP_BONUS", "label": [{ "t": 7 }, { "v": { "of": "maxHp", "pct": 10 } }, { "s": " ]" }], "refs": [] }
