NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
NEXT_PUBLIC_SUPABASE_ENV=development

# Supabase CLI (migrations). Never prefix these with NEXT_PUBLIC_.
# Copy into .env.local, then:
#   set -a && source .env.local && set +a
#   supabase link --project-ref "$SUPABASE_PROJECT_REF" --password "$SUPABASE_DB_PASSWORD"
#   supabase db push --linked --dry-run
#   supabase db push --linked
#
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project Settings → General → Reference ID (xxxx in xxxx.supabase.co)
SUPABASE_PROJECT_REF=
# Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=
