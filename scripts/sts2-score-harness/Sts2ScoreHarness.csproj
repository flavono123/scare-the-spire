<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ground truth for src/lib/sts2/run-score.ts: runs the game's own ScoreUtility on run history files. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/sts2-builds/0.113.0/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameDir)/sts2.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)/GodotSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
