{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scare-the-spire",
  "main": "workers/main-worker.ts",
  "minify": true,
  "compatibility_date": "2026-06-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS",
    // Same-origin API (docs/supabase-exit/STEP1_DESIGN.md 4.1): no asset may shadow it.
    "run_worker_first": ["/api/*"]
  },
  // Supabase exit switch. "d1" reads runtime_flags (on since step 2, 2026-11-09); "off" skips D1
  // entirely and every /api request answers 409 surface_legacy. Since step 6 the browser has no
  // legacy path (docs/supabase-exit/STEP6_PLAN.md), so "off" stops every community feature: each
  // screen shows its "unavailable" notice and no claim or write goes through. A missing
  // API_SUPABASE_URL, API_SUPABASE_KEY or API_DATA_ENV (not_configured) does the same; they are
  // passed with --var at deploy time and stay until step 7. Roll back with source.<group> (storage)
  // or by rolling both Workers (main and patch) back to their recorded pre-step-6 versions (client),
  // never with "off": "off", path.<group> legacy, identity.mode token and write.<group> rls only work
  // with a pre-step-6 client, and scripts/runtime-flags.ts refuses the last three without --old-client.
  // Step 4 identity (docs/SUPABASE_EXIT_PLAN.md 5.3) reads two Worker secrets, set
  // with `wrangler secret put` per env, never here: API_IDENTITY_SECRET (cookie HMAC
  // key, at least 32 characters; without it identity stays on bearer tokens, which the step 6
  // browser never sends, so claims and writes fail) and,
  // optionally, API_SUPABASE_LEGACY_JWT_SECRET (claims of old HS256 tokens).
  // API_PATH_DEFAULT (legacy|api, unset = legacy) is the path of a group whose path.<group> row
  // is missing or unknown or whose flags cannot be read (plan 7.2), in the router and the page
  // cookie. It went to api before the direct writes were closed (docs/supabase-exit/STEP4_WRITE_GATE.md 7;
  // 2026-11-09, every path.<group> was already api); since step 6 legacy is an outage like "off".
  // API_WRITE_MODE_DEFAULT is the write mode of a group whose
  // write.<group> row is missing or cannot be read: worker since 2026-11-09, with every production
  // write.<group> row set explicitly, so the default only decides a failed flag read.
  // API_WRITE_SOURCE_DEFAULT is the write source of a group whose source.<group> row is missing or
  // cannot be read: d1 since the step 5 cutover (production 2026-11-09 13:29 UTC, testbed 13:26 UTC).
  // API_IDENTITY_MODE_DEFAULT (token|cookie, unset = token) is the identity mode when the
  // identity.mode row is missing or unknown or the flags cannot be read (workers/api/identity/mode.ts):
  // cookie for step 6, whose browser has no token path (STEP6_PLAN.md 2, P12). The kill switch, a
  // missing API_IDENTITY_SECRET and the QA cookie still mean token.
  "vars": {
    "API_RUNTIME_FLAGS": "d1",
    "API_PATH_DEFAULT": "api",
    "API_WRITE_MODE_DEFAULT": "worker",
    "API_WRITE_SOURCE_DEFAULT": "d1",
    "API_IDENTITY_MODE_DEFAULT": "cookie"
  },
  // Step 2 1-minute D1 sync (docs/supabase-exit/D1_SCHEMA_DESIGN.md 5.3). A no-op unless
  // API_RUNTIME_FLAGS is "d1" and runtime_flags sync.enabled is on; API_SUPABASE_SECRET_KEY is a secret.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slseoun-prod",
      "database_id": "b0dc1d98-7091-4d77-bccf-8bdb05a32af5",
      "migrations_dir": "d1/migrations"
    }
  ],
  "services": [
    {
      "binding": "PATCH_WORKER",
      "service": "scare-the-spire-patches"
    }
  ],
  "ratelimits": [
    {
      "name": "LINK_PREVIEW_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    // Same-origin API (docs/supabase-exit/STEP1_DESIGN.md 9.1): uncached public reads per IP,
    // writes and personal reads per verified user.
    {
      "name": "API_READ_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "API_WRITE_LIMITER",
      "namespace_id": "1102",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "env": {
    "testbed": {
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "API_RUNTIME_FLAGS": "d1",
        "API_PATH_DEFAULT": "api",
        "API_WRITE_MODE_DEFAULT": "worker",
        "API_WRITE_SOURCE_DEFAULT": "d1",
        "API_IDENTITY_MODE_DEFAULT": "cookie"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "slseoun-testbed",
          "database_id": "11081204-f9ca-4b30-b2e0-07ca427cc410",
          "migrations_dir": "d1/migrations"
        }
      ],
      "services": [
        {
          "binding": "PATCH_WORKER",
          "service": "scare-the-spire-patches-testbed"
        }
      ],
      "ratelimits": [
        {
          "name": "LINK_PREVIEW_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "API_READ_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "API_WRITE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
