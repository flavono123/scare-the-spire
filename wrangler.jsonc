{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scare-the-spire",
  "main": "workers/main-worker.ts",
  "minify": true,
  "compatibility_date": "2026-06-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "PATCH_WORKER",
      "service": "scare-the-spire-patches"
    }
  ],
  "ratelimits": [
    {
      "name": "LINK_PREVIEW_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "env": {
    "testbed": {
      "workers_dev": true,
      "preview_urls": true,
      "services": [
        {
          "binding": "PATCH_WORKER",
          "service": "scare-the-spire-patches-testbed"
        }
      ],
      "ratelimits": [
        {
          "name": "LINK_PREVIEW_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
