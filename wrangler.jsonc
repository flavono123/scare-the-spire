{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scare-the-spire",
  "main": "workers/main-worker.ts",
  "minify": true,
  "compatibility_date": "2026-06-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS",
    // Same-origin API (docs/supabase-exit/STEP1_DESIGN.md 4.1): no asset may shadow it.
    "run_worker_first": ["/api/*"]
  },
  // Step 1 of the Supabase exit. "off" keeps every screen on the legacy path and
  // skips D1 entirely; "d1" reads runtime_flags. API_SUPABASE_URL, API_SUPABASE_KEY
  // and API_DATA_ENV are passed with --var at deploy time.
  // Step 4 identity (docs/SUPABASE_EXIT_PLAN.md 5.3) reads two Worker secrets, set
  // with `wrangler secret put` per env, never here: API_IDENTITY_SECRET (cookie HMAC
  // key, at least 32 characters; without it identity stays on bearer tokens) and,
  // optionally, API_SUPABASE_LEGACY_JWT_SECRET (claims of old HS256 tokens).
  "vars": {
    "API_RUNTIME_FLAGS": "off"
  },
  // Step 2 1-minute D1 sync (docs/supabase-exit/D1_SCHEMA_DESIGN.md 5.3). A no-op unless
  // API_RUNTIME_FLAGS is "d1" and runtime_flags sync.enabled is on; API_SUPABASE_SECRET_KEY is a secret.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slseoun-prod",
      "database_id": "b0dc1d98-7091-4d77-bccf-8bdb05a32af5",
      "migrations_dir": "d1/migrations"
    }
  ],
  "services": [
    {
      "binding": "PATCH_WORKER",
      "service": "scare-the-spire-patches"
    }
  ],
  "ratelimits": [
    {
      "name": "LINK_PREVIEW_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    // Same-origin API (docs/supabase-exit/STEP1_DESIGN.md 9.1): uncached public reads per IP,
    // writes and personal reads per verified user.
    {
      "name": "API_READ_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "API_WRITE_LIMITER",
      "namespace_id": "1102",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "env": {
    "testbed": {
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "API_RUNTIME_FLAGS": "d1"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "slseoun-testbed",
          "database_id": "11081204-f9ca-4b30-b2e0-07ca427cc410",
          "migrations_dir": "d1/migrations"
        }
      ],
      "services": [
        {
          "binding": "PATCH_WORKER",
          "service": "scare-the-spire-patches-testbed"
        }
      ],
      "ratelimits": [
        {
          "name": "LINK_PREVIEW_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "API_READ_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "API_WRITE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
