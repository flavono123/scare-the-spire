{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scare-the-spire-sts1",
  "main": "workers/sts1-worker.ts",
  "minify": true,
  "compatibility_date": "2026-06-15",
  // No public URL: only the main Worker's STS1_WORKER binding reaches it, so every
  // response goes out through main's page and security headers
  // (docs/designs/sts1-compendium-worker.md).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".sts1-worker/assets",
    "binding": "ASSETS",
    // main asks for exact file paths (/_cf_static_pages/<page>.html|.rsc, /_next/static/...).
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "env": {
    "testbed": {
      "workers_dev": false,
      "preview_urls": false
    }
  },
  "observability": {
    "enabled": true
  }
}
